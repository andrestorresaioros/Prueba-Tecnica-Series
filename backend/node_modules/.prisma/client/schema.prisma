generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SeriesStatus {
  ANNOUNCED
  EMISSION
  FINISHED
  CANCELLED
}

model Series {
  id          String           @id @default(cuid())
  name        String
  releaseDate DateTime
  synopsis    String?
  country     String?
  seasons     Int              @default(1)
  rating      Decimal?         @db.Decimal(3, 1)
  status      SeriesStatus     @default(EMISSION)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  directors   SeriesDirector[]

  @@index([name])
  @@map("series")
}

model Director {
  id          String           @id @default(cuid())
  fullName    String
  nationality String?
  birthDate   DateTime?
  biography   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  series      SeriesDirector[]

  @@unique([fullName])
  @@index([fullName])
  @@map("directors")
}

model SeriesDirector {
  seriesId   String
  directorId String
  role       String   @default("DIRECTOR")
  createdAt  DateTime @default(now())

  series   Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  director Director @relation(fields: [directorId], references: [id], onDelete: Cascade)

  @@id([seriesId, directorId])
  @@map("series_directors")
}
